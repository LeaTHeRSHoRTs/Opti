{
  "name": "optijs",
  "type": "module",
  "version": "0.0.4",
  "author": "LeaTHeR_SHoRTs",
  "license": "CC-BY-NC-SA-4.0",
  "private": false,
  "description": "Lightweight DOM manipulation, styling, and utility extension for native JavaScript objects — without wrappers.",
  "exports": {
    "opti": {
      "types": "./types/index.d.ts"
    }
  },
  "homepage": "https://github.com/LeaTHeRSHoRTs/Opti",
  "bugs": "https://github.com/LeaTHeRSHoRTs/Opti/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LeaTHeRSHoRTs/Opti.git"
  },
  "keywords": [
    "dom",
    "javascript",
    "opti",
    "optijs",
    "utility",
    "dom manipulation",
    "library",
    "web",
    "frontend"
  ],
  "files": [
    "types",
    "dist",
    "LICENSE",
    "README.md"
  ],
  "babel": {
    "presets": [
      "@babel/preset-env"
    ]
  },
  "sideEffects": true,
  "scripts": {
    "build": "vite build",
    "lint": "oxlint .",
    "typecheck": "npm run typecheck:src && npm run typecheck:types && npm run typecheck:tests",
    "typecheck:src": "tsc -p src",
    "typecheck:tests": "tsc -p tests",
    "typecheck:types": "tsc -p types",
    "check": "npm run lint && npm run typecheck",
    "test": "vitest",
    "test:watch": "vitest watch"
  },
  "engines": {
    "node": ">=23.0.0"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@types/node": "^26.6.3",
    "@vitest/browser-playwright": "^5.1.1",
    "globals": "^17.12.0",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "playwright": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
