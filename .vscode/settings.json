{
  "files.exclude": {
    "**/coverage": true,
    "**/node_modules": false
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.hg/store/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true
  },
  "cSpell.words": [
    "basicnodes",
    "browserlist",
    "canvastext",
    "constructableobjects",
    "documentalias",
    "evented",
    "flowback",
    "flowclass",
    "htmlelement",
    "icss",
    "mprescripts",
    "optijs",
    "requestfunc",
    "TSES",
    "unsync",
    "voidhtmlelement"
  ],
  "js/ts.tsdk.path": "node_modules\\typescript\\lib",
  "js/ts.tsserver.automaticTypeAcquisition.enabled": false,
  "js/ts.validate.enabled": true
}