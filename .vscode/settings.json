{
  "files.exclude": {
    "**/coverage": true,
    "**/node_modules": false
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/.hg/store/**": true,
    "**/dist/**": true,
    "**/node_modules/**": true
  },
  "cSpell.words": [
    "basicnodes",
    "broski",
    "canvastext",
    "constructableobjects",
    "evented",
    "flowback",
    "flowclass",
    "icss",
    "mprescripts",
    "optijs",
    "requestfunc",
    "TSES",
    "unsync"
  ],
  "json.schemas": [
    {
      "fileMatch": ["**/assets/*.json"],
      "schema": {
        "additionalItems": {
          "__doc__": "string",
          "additionalItems": {
            "type": "string"
          }
        }
      }
    }
  ],
  "js/ts.tsdk.path": "node_modules\\typescript\\lib",
  "js/ts.tsserver.automaticTypeAcquisition.enabled": false,
  "js/ts.validate.enabled": true
}