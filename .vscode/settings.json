{
  "typescript.tsdk": "./node_modules/typescript/lib",
  "jest.runMode": {
    "runAllTestsOnStartup": true,
    "type": "on-demand"
  },
  "code-runner.executorMap": {
    "typescript": "node scripts/ts-node.cjs $fullFileName",
  },
  "jest.jestCommandLine": "npm run test",
  "files.exclude": {
    "**/coverage": true,
  },
  "cSpell.words": [
    "broski",
    "constructableobjects",
    "flowclass",
    "optijs",
    "unsync"
  ]
}