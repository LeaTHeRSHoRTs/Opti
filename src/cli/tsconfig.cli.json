{
  "compilerOptions": {
    "target": "es2017",
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": ".",
    "outDir": "../../bin",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "lib": [],
    "types": ["node"]
  },
  "include": [
    "./*.ts"
  ],
  "exclude": [
    "../types/**/*.d.ts"
  ]
}