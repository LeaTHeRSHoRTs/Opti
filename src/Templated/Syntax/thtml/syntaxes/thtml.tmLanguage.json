{
  "$schema": "https://raw.githubusercontent.com/RedCMD/TmLanguage-Syntax-Highlighter/main/vscode.tmLanguage.schema.json",
  "scopeName": "text.html.templated",
  "name": "Templated HTML",
  "fileTypes": [
    "thtml", 
    "thtm", 
    "templated.html",
    "js.thtml",
    "js.thtm",
    "ts.thtml",
    "ts.thtm"
  ],
  "patterns": [
    { "include": "text.html.basic" },
    {
      "name": "meta.embedded.javascriptlang",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        { "include": "source.js" }
      ]
    }
  ],
  "embeddedLanguages": {
    "meta.embedded.javascriptlang": "javascript"
  }
}