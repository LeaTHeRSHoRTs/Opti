{
  "name": "thtml-synatx-highlighting",
  "displayName": "THTML Syntax Highlighting",
  "description": "",
  "publisher": "LeaTHeR_SHoRTs",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "thtml",
      "aliases": ["THTML", "thtml"],
      "extensions": [".thtml",".thtm",".templated.html"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "thtml",
      "scopeName": "text.html.templated",
      "path": "./syntaxes/thtml.tmLanguage.json"
    }]
  }
}
